<%# app/views/pages/home.html.erb %>
<% content_for :title, "CargaClick — Frete mais justo" %>

<!-- ==================================================
     EMOJI + SAUDAÇÃO (BLOCO 0)
================================================== -->
<section class="max-w-6xl mx-auto px-6 pt-12 text-center">

  <!-- Emoji em círculo com animação -->
  <div class="mb-8 inline-block animate-slideInUp">
    <div class="w-20 h-20 md:w-24 md:h-24
                bg-gradient-to-br from-blue-500/20 to-blue-600/20
                backdrop-blur-sm border border-blue-300/30
                dark:border-blue-400/20 rounded-full
                flex items-center justify-center
                shadow-lg hover:shadow-2xl
                transition-shadow duration-300
                animate-float">
      <span class="text-5xl md:text-6xl"
            role="img"
            aria-label="Caminhão de entregas">
        🚚
      </span>
    </div>
  </div>

  <!-- Saudação -->
  <h2 class="text-2xl md:text-3xl font-bold
             text-blue-700 dark:text-blue-300
             mb-6 animate-slideInUp"
      style="animation-delay: 0.1s;">
    <span role="img" aria-label="bem-vindo ao CargaClick">👋</span>
    Bem-vindo ao CargaClick!
  </h2>

</section>

<!-- ==================================================
     HERO + SELO (BLOCO 1)
================================================== -->
<section class="max-w-6xl mx-auto px-6 py-24 text-center">

  <!-- TÍTULO -->
  <h1 class="text-4xl md:text-5xl font-extrabold text-gray-900 dark:text-white mb-6">
    Frete mais justo começa aqui
  </h1>

  <!-- SUBTÍTULO -->
  <p class="text-lg text-gray-600 max-w-2xl mx-auto mb-8">
    Simule, compare e contrate com transparência.
    Sem taxas abusivas. Sem surpresas no final.
  </p>

  <!-- SELO -->
  <div class="flex justify-center mb-10">
    <div class="inline-flex items-center gap-2
                bg-gradient-to-r from-green-500 to-emerald-600
                text-white px-6 py-3 rounded-full shadow-xl animate-pulse">
      <span class="text-xl">💸</span>
      <span class="font-semibold">
        Até 22% mais barato que apps tradicionais
      </span>
    </div>
  </div>

  <!-- CTA -->
  <div class="flex justify-center gap-4 flex-wrap">

    <% if respond_to?(:simular_frete_path) %>
      <%= link_to "Simular frete agora",
                  simular_frete_path,
                  class: "bg-blue-600 hover:bg-blue-700 text-white
                          font-bold px-8 py-4 rounded-xl transition shadow-lg" %>
    <% end %>

    <%= link_to "Como funciona",
                "#como-funciona",
                class: "bg-gray-100 hover:bg-gray-200 text-gray-700
                        font-semibold px-8 py-4 rounded-xl transition" %>
  </div>

</section>

<!-- ==================================================
     COMO FUNCIONA (BLOCO 2)
================================================== -->
<section id="como-funciona" class="max-w-6xl mx-auto px-6 py-20">

  <h2 class="text-3xl font-bold text-center text-gray-900 mb-12">
    Simples, rápido e transparente
  </h2>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center">

    <!-- PASSO 1 -->
    <div class="p-8 rounded-3xl bg-gray-50 shadow hover:shadow-lg transition">
      <div class="text-4xl mb-4">🔍</div>
      <h3 class="font-semibold text-lg mb-2">Simule</h3>
      <p class="text-gray-600">
        Informe origem, destino e carga.
        Sem cadastro.
      </p>
    </div>

    <!-- PASSO 2 -->
    <div class="p-8 rounded-3xl bg-gray-50 shadow hover:shadow-lg transition">
      <div class="text-4xl mb-4">💰</div>
      <h3 class="font-semibold text-lg mb-2">Compare</h3>
      <p class="text-gray-600">
        Veja o preço final, já com a menor taxa do mercado.
      </p>
    </div>

    <!-- PASSO 3 -->
    <div class="p-8 rounded-3xl bg-gray-50 shadow hover:shadow-lg transition">
      <div class="text-4xl mb-4">🚚</div>
      <h3 class="font-semibold text-lg mb-2">Contrate</h3>
      <p class="text-gray-600">
        Pague com segurança e acompanhe seu frete.
      </p>
    </div>

  </div>

</section>
