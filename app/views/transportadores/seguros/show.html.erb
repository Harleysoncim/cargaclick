<% content_for :title, "Seguro da carga — Frete ##{@frete.id}" %>

<main class="mx-auto max-w-4xl px-4 py-8" data-nfe-reader>
  <div class="mb-6">
    <%= link_to "← Voltar ao frete", frete_path(@frete), class: "text-sm font-semibold text-purple-700 hover:underline" %>
    <h1 class="mt-3 text-3xl font-extrabold text-gray-900">Seguro da carga</h1>
    <p class="mt-2 text-gray-600">Frete #<%= @frete.id %> · <%= @frete.origem %> → <%= @frete.destino %></p>
  </div>

  <ol class="mb-8 grid grid-cols-2 gap-2 text-center text-xs font-semibold text-gray-600 sm:grid-cols-5" aria-label="Etapas">
    <% ["Nota fiscal", "Escolha", "Dados da carga", "Cotação", "Confirmação"].each_with_index do |step, index| %>
      <li class="rounded-lg bg-purple-50 px-2 py-3"><%= index + 1 %>. <%= step %></li>
    <% end %>
  </ol>

  <div aria-live="polite" class="mb-5">
    <% if notice.present? %><p class="rounded-lg bg-green-50 p-4 text-green-800"><%= notice %></p><% end %>
    <% if alert.present? %><p class="rounded-lg bg-red-50 p-4 text-red-800"><%= alert %></p><% end %>
  </div>

  <section class="rounded-2xl bg-white p-5 shadow-lg sm:p-7" aria-labelledby="nota-title">
    <h2 id="nota-title" class="text-xl font-bold text-gray-900">1. Nota fiscal</h2>
    <p class="mt-2 text-sm text-gray-600">A imagem é lida somente neste aparelho e não é enviada nem armazenada.</p>

    <% if @frete.nfe_lida_em.present? %>
      <dl class="mt-5 grid gap-3 rounded-xl bg-green-50 p-4 text-sm sm:grid-cols-2">
        <div><dt class="font-semibold">Chave</dt><dd><%= @frete.nfe_chave_mascarada || "Não disponível no QR Code" %></dd></div>
        <% if @frete.nfe_numero.present? %><div><dt class="font-semibold">Número</dt><dd><%= @frete.nfe_numero %></dd></div><% end %>
        <% if @frete.nfe_emitente_nome.present? %><div><dt class="font-semibold">Emitente</dt><dd><%= @frete.nfe_emitente_nome %></dd></div><% end %>
        <% if @frete.nfe_valor_total.present? %><div><dt class="font-semibold">Valor</dt><dd><%= number_to_currency(@frete.nfe_valor_total) %></dd></div><% end %>
        <div><dt class="font-semibold">Lida em</dt><dd><%= l(@frete.nfe_lida_em, format: :short) %></dd></div>
      </dl>
    <% end %>

    <div class="mt-5 flex flex-wrap gap-3">
      <button type="button" data-camera-open class="min-h-12 rounded-xl bg-purple-700 px-5 py-3 font-bold text-white hover:bg-purple-800">Ler QR Code da nota</button>
      <label class="min-h-12 cursor-pointer rounded-xl border-2 border-purple-700 px-5 py-3 font-bold text-purple-700">
        Enviar foto do QR Code
        <input type="file" accept="image/*" capture="environment" class="sr-only" data-qr-image>
      </label>
    </div>

    <div data-camera-panel hidden class="mt-5 rounded-xl bg-gray-950 p-3">
      <video data-camera-video playsinline class="mx-auto max-h-96 w-full rounded-lg" aria-label="Visualização da câmera"></video>
      <button type="button" data-camera-close class="mt-3 min-h-11 rounded-lg bg-white px-4 py-2 font-semibold text-gray-900">Fechar leitor</button>
    </div>
    <p data-reader-status aria-live="polite" class="mt-3 text-sm text-gray-700"></p>

    <%= form_with url: ler_nfe_transportadores_frete_seguro_path(@frete), method: :post, class: "mt-5", data: { qr_form: true } do |form| %>
      <%= form.label :nfe_qrcode_text, "Colar chave ou endereço da nota", class: "block font-semibold text-gray-800" %>
      <%= form.text_area :nfe_qrcode_text, value: params[:nfe_qrcode_text], rows: 3, autocomplete: "off", class: "mt-2 w-full rounded-xl border-gray-300", data: { qr_input: true }, required: true %>
      <%= form.submit "Continuar", class: "mt-3 min-h-12 rounded-xl bg-purple-700 px-6 py-3 font-bold text-white", data: { disable_with: "Verificando…" } %>
    <% end %>

    <% if @nfe_preview&.success? %>
      <div class="mt-5 rounded-xl border border-amber-300 bg-amber-50 p-4">
        <h3 class="font-bold">Confirme antes de vincular</h3>
        <p class="mt-1 text-sm">Chave: <%= @nfe_preview.access_key ? "#{@nfe_preview.access_key.first(6)}********************************#{@nfe_preview.access_key.last(6)}" : "não encontrada no endereço" %></p>
        <%= form_with url: transportadores_frete_seguro_path(@frete), method: :patch, class: "mt-3" do |form| %>
          <%= hidden_field_tag :nfe_qrcode_text, params[:nfe_qrcode_text] %>
          <%= form.submit "Confirmar e vincular nota", class: "min-h-12 rounded-xl bg-green-700 px-5 py-3 font-bold text-white", data: { disable_with: "Salvando…" } %>
        <% end %>
      </div>
    <% end %>
  </section>

  <section class="mt-6 rounded-2xl bg-white p-5 shadow-lg sm:p-7" aria-labelledby="choice-title">
    <h2 id="choice-title" class="text-xl font-bold text-gray-900">2. Escolha do seguro</h2>
    <div class="mt-5 grid gap-4 sm:grid-cols-2">
      <a href="#dados-seguro" class="flex min-h-20 items-center justify-center rounded-xl bg-green-700 p-4 text-center font-bold text-white">Sim, quero cotar o seguro</a>
      <%= button_to "Não quero seguro para esta carga", transportadores_frete_seguro_path(@frete), method: :patch,
          params: { decision: "sem_seguro" }, class: "min-h-20 w-full rounded-xl border-2 border-gray-500 p-4 font-bold text-gray-800",
          form: { data: { turbo_confirm: "A carga seguirá sem seguro contratado pela plataforma. Confirmar?" } } %>
    </div>
    <% if @frete.seguro_status == "recusado" %>
      <p class="mt-4 text-sm text-amber-800">Decisão atual: sem seguro pela plataforma.</p>
      <% if @frete.seguro_editavel? %><%= button_to "Mudar decisão", transportadores_frete_seguro_path(@frete), method: :delete, class: "mt-2 font-semibold text-purple-700 underline" %><% end %>
    <% end %>
  </section>

  <section id="dados-seguro" class="mt-6 rounded-2xl bg-white p-5 shadow-lg sm:p-7">
    <h2 class="text-xl font-bold text-gray-900">3. Dados para cotação</h2>
    <p class="mt-2 text-sm text-gray-600">Serão enviados ao futuro provider: valor, mercadoria, rota, peso, veículo, documento do emitente e riscos informados.</p>
    <%= form_with model: @frete, url: cotar_transportadores_frete_seguro_path(@frete), method: :post, class: "mt-5 grid gap-4 sm:grid-cols-2" do |form| %>
      <div><%= form.label :seguro_valor_carga, "Valor total da carga", class: "block font-semibold" %><%= form.number_field :seguro_valor_carga, min: 0.01, step: 0.01, required: true, class: "mt-1 w-full rounded-xl border-gray-300" %></div>
      <div><%= form.label :nfe_emitente_documento, "CNPJ/CPF do emitente", class: "block font-semibold" %><%= form.text_field :nfe_emitente_documento, class: "mt-1 w-full rounded-xl border-gray-300", autocomplete: "off" %></div>
      <div class="sm:col-span-2"><%= form.label :seguro_descricao_mercadoria, "Tipo/descrição da mercadoria", class: "block font-semibold" %><%= form.text_area :seguro_descricao_mercadoria, rows: 3, required: true, class: "mt-1 w-full rounded-xl border-gray-300" %></div>
      <div><%= form.label :seguro_origem, "Origem", class: "block font-semibold" %><%= form.text_field :seguro_origem, value: @frete.seguro_origem.presence || @frete.origem, required: true, class: "mt-1 w-full rounded-xl border-gray-300" %></div>
      <div><%= form.label :seguro_destino, "Destino", class: "block font-semibold" %><%= form.text_field :seguro_destino, value: @frete.seguro_destino.presence || @frete.destino, required: true, class: "mt-1 w-full rounded-xl border-gray-300" %></div>
      <div><%= form.label :seguro_peso, "Peso (kg)", class: "block font-semibold" %><%= form.number_field :seguro_peso, value: @frete.seguro_peso.presence || @frete.peso.presence || @frete.peso_aproximado, min: 0.01, step: 0.01, required: true, class: "mt-1 w-full rounded-xl border-gray-300" %></div>
      <div><%= form.label :seguro_tipo_veiculo, "Tipo de veículo", class: "block font-semibold" %><%= form.text_field :seguro_tipo_veiculo, value: @frete.seguro_tipo_veiculo.presence || current_transportador.tipo_veiculo, required: true, class: "mt-1 w-full rounded-xl border-gray-300" %></div>
      <fieldset class="sm:col-span-2"><legend class="font-semibold">Características da carga</legend><div class="mt-2 flex flex-wrap gap-5">
        <label><%= form.check_box :seguro_carga_perigosa %> Perigosa</label><label><%= form.check_box :seguro_carga_perecivel %> Perecível</label><label><%= form.check_box :seguro_carga_alto_valor %> Alto valor</label>
      </div></fieldset>
      <label class="sm:col-span-2 rounded-xl bg-blue-50 p-4"><%= form.check_box :seguro_consentimento, required: true %> Concordo com o envio dos dados acima à seguradora para análise da cotação.</label>
      <div class="sm:col-span-2"><%= form.submit "Solicitar cotação", class: "min-h-12 w-full rounded-xl bg-purple-700 px-6 py-3 font-bold text-white sm:w-auto", data: { disable_with: "Enviando…" } %></div>
    <% end %>
  </section>

  <section class="mt-6 rounded-2xl bg-gray-900 p-5 text-white shadow-lg sm:p-7" aria-live="polite">
    <h2 class="text-xl font-bold">4. Status da cotação</h2>
    <p class="mt-3 text-lg"><%= @frete.seguro_status.humanize %></p>
    <% if @frete.seguro_status == "aguardando_cotacao" %><p class="mt-2 text-amber-200">Solicitação enviada para análise. A carga ainda não está segurada.</p><% end %>
    <% if @frete.seguro_status == "contratado" %><p class="mt-2 text-green-300 font-bold">Carga segurada — confirmação recebida da seguradora.</p><% else %><p class="mt-2 text-sm text-gray-300">Cotação não significa seguro contratado.</p><% end %>
  </section>
</main>
