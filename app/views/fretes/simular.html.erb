<%# app/views/fretes/simular.html.erb %>

<div class="max-w-4xl mx-auto mt-10">

  <!-- ==================================================
       BREADCRUMB
  ================================================== -->
  <nav class="text-sm text-gray-500 dark:text-gray-400 mb-4">
    <ol class="flex flex-wrap items-center gap-2">
      <li>
        <%= link_to "Início", root_path, class: "hover:text-blue-600 transition" %>
      </li>
      <li>/</li>
      <li>
        <%= link_to "Simular Frete", simular_frete_path, class: "hover:text-blue-600 transition" %>
      </li>
      <li>/</li>
      <li class="font-semibold text-gray-700 dark:text-gray-200">
        Resultado
      </li>
    </ol>
  </nav>

  <!-- ==================================================
       CARD PRINCIPAL
  ================================================== -->
  <div class="p-8 bg-white dark:bg-gray-800 rounded-3xl shadow-xl">

    <h1 class="text-3xl font-extrabold text-gray-900 dark:text-gray-100 mb-6">
      📊 Resultado da Simulação
    </h1>

    <% if @resultado.present? && @resultado[:sucesso] %>

      <!-- =========================
           DADOS DA SIMULAÇÃO
      ========================== -->
      <div class="space-y-4 text-gray-700 dark:text-gray-200">

        <div class="flex justify-between">
          <span class="font-semibold">Origem</span>
          <span><%= @resultado[:origem] %></span>
        </div>

        <div class="flex justify-between">
          <span class="font-semibold">Destino</span>
          <span><%= @resultado[:destino] %></span>
        </div>

        <div class="flex justify-between">
          <span class="font-semibold">Distância estimada</span>
          <span><%= @resultado[:distancia_km] %> km</span>
        </div>

      </div>

      <dl class="mt-6 space-y-3" data-testid="simulation-breakdown">
        <div><dt class="font-semibold">Peso (kg)</dt><dd><%= number_with_delimiter(@resultado[:peso], separator: ",", delimiter: ".") %></dd></div>
        <div><dt class="font-semibold">Volume (m³)</dt><dd><%= number_with_delimiter(@resultado[:volume], separator: ",", delimiter: ".") %></dd></div>
        <% if @resultado[:breakdown].present? %>
          <div><dt class="font-semibold">Subtotal por distância</dt><dd><%= number_to_currency(@resultado[:breakdown][:subtotal_km], unit: "R$ ", separator: ",", delimiter: ".") %></dd></div>
          <div><dt class="font-semibold">Tarifa mínima</dt><dd><%= number_to_currency(@resultado[:breakdown][:taxa_minima], unit: "R$ ", separator: ",", delimiter: ".") %></dd></div>
        <% end %>
      </dl>

      <!-- =========================
           VALOR FINAL (COMPETITIVO)
      ========================== -->
      <div class="mt-6 p-6 bg-gray-50 dark:bg-gray-900 rounded-2xl border border-gray-200 dark:border-gray-700">

        <div class="flex justify-between items-center mb-3">
          <span class="font-semibold text-gray-700 dark:text-gray-200">
            Valor final do frete
          </span>
          <span class="text-3xl font-extrabold text-green-600">
            R$ <%= number_to_currency(@resultado[:valor_total], unit: "", separator: ",", delimiter: ".") %>
          </span>
        </div>

        <!-- DIFERENCIAL COMPETITIVO -->
        <div class="text-sm text-green-600 font-semibold mt-2">
          💸 Até 22% mais barato que apps tradicionais — ganho certo para todos
        </div>

        <div class="text-xs text-gray-500 dark:text-gray-400 mt-1">
          Preço final fechado, sem taxas surpresa.
        </div>

      </div>

      <!-- =========================
           CTA
      ========================== -->
      <div class="mt-8 flex flex-col md:flex-row gap-4">

        <% if @resultado[:rota_geojson].present? %>
          <button type="button"
                  class="flex-1 bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 rounded-xl transition shadow"
                  data-route-map-open
                  aria-haspopup="dialog">
            Rota no mapa
          </button>
        <% end %>

        <%= link_to "Nova simulação",
          simular_frete_path,
          class: "flex-1 text-center px-6 py-3 rounded-xl bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold transition" %>

        <% if cliente_signed_in? %>
          <%= button_to "Contratar Frete",
            fretes_path,
            method: :post,
            params: {
              frete: {
                origem: @resultado[:origem],
                destino: @resultado[:destino],
                peso: @resultado[:peso],
                volume: @resultado[:volume],
                valor: @resultado[:valor_total]
              }
            },
            class: "flex-1 bg-green-600 hover:bg-green-700 text-white font-bold py-3 rounded-xl transition shadow" %>
        <% else %>
          <%= link_to "Entrar para contratar",
            new_cliente_session_path,
            class: "flex-1 text-center bg-green-600 hover:bg-green-700 text-white font-bold py-3 rounded-xl transition shadow" %>
        <% end %>

      </div>

    <% else %>

      <!-- =========================
           ERRO
      ========================== -->
      <div class="bg-red-50 border border-red-200 text-red-700 p-6 rounded-xl">
        <p class="font-semibold mb-2">Não foi possível calcular o frete.</p>
        <p>
          <%= @resultado[:mensagem] rescue "Erro inesperado ao processar a simulação." %>
        </p>
      </div>

      <div class="mt-6">
        <%= link_to "Voltar",
          simular_frete_path,
          class: "px-6 py-3 rounded-xl bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold" %>
      </div>

    <% end %>

  </div>
</div>

<% if @resultado.present? && @resultado[:sucesso] && @resultado[:rota_geojson].present? %>
  <div class="fixed inset-0 z-[1000] hidden bg-black/60 p-4 md:p-8"
       data-route-map-modal
      data-route-map-auto-open
       role="dialog"
       aria-modal="true"
       aria-labelledby="route-map-title">
    <div class="mx-auto flex h-full max-w-5xl flex-col overflow-hidden rounded-2xl bg-white shadow-2xl">
      <header class="flex items-center justify-between gap-4 border-b border-gray-200 px-5 py-4">
        <div>
          <h2 id="route-map-title" class="text-xl font-bold text-gray-900">Rota no mapa</h2>
          <p class="text-sm text-gray-600"><%= @resultado[:origem] %> → <%= @resultado[:destino] %></p>
        </div>
        <button type="button"
                class="rounded-lg px-3 py-2 text-2xl leading-none text-gray-700 hover:bg-gray-100"
                data-route-map-close
                aria-label="Fechar mapa">&times;</button>
      </header>

      <div class="grid min-h-0 flex-1 grid-cols-1 md:grid-cols-[1fr_18rem]">
        <div class="min-h-[18rem]" data-route-map-canvas aria-label="Mapa da rota"></div>
        <aside class="border-t border-gray-200 p-5 md:border-l md:border-t-0">
          <dl class="space-y-4 text-sm text-gray-700">
            <div><dt class="font-semibold">Distância</dt><dd><%= @resultado[:distancia_km] %> km</dd></div>
            <div><dt class="font-semibold">Duração</dt><dd><%= @resultado[:duracao_minutos] %> min</dd></div>
            <div><dt class="font-semibold">Peso</dt><dd><%= @resultado[:peso] %> kg</dd></div>
            <div><dt class="font-semibold">Volume</dt><dd><%= @resultado[:volume] %> m³</dd></div>
            <div><dt class="font-semibold">Valor</dt><dd><%= number_to_currency(@resultado[:valor_total], unit: "R$ ", separator: ",", delimiter: ".") %></dd></div>
          </dl>
        </aside>
      </div>
      <p class="border-t border-gray-200 px-5 py-3 text-xs text-gray-500">
        Mapa © OpenStreetMap contributors · Rota calculada pelo OpenRouteService
      </p>
    </div>
    <script type="application/json" data-route-map-data><%= raw json_escape({
      geojson: @resultado[:rota_geojson],
      origem: @resultado[:origem],
      destino: @resultado[:destino],
      origem_coords: @resultado[:origem_coords],
      destino_coords: @resultado[:destino_coords]
    }.to_json) %></script>
  </div>
<% end %>


