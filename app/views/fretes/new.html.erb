<%# app/views/fretes/new.html.erb %>
<% content_for :title, "Simular Frete" %>

<!-- ==================================================
     BREADCRUMB
================================================== -->
<nav class="text-sm text-gray-500 mb-4">
  <ol class="flex flex-wrap items-center gap-2">
    <li>
      <%= link_to "Início", root_path, class: "hover:text-blue-600 transition" %>
    </li>
    <li>/</li>
    <li class="font-semibold text-gray-700">
      Simular Frete
    </li>
  </ol>
</nav>

<!-- ==================================================
     CABEÇALHO
================================================== -->
<header class="mb-6">
  <h1 class="text-3xl font-extrabold text-gray-900">
    🚛 Simule seu frete em segundos
  </h1>
  <p class="mt-2 text-gray-600 max-w-2xl">
    Compare valores, distância e condições.
    Simulação gratuita. Login apenas para contratar.
  </p>
</header>

<!-- ==================================================
     CARD — SIMULAÇÃO
================================================== -->
<section class="bg-white shadow-xl rounded-3xl p-8 mb-8">
  <h2 class="text-xl font-semibold text-gray-800 mb-6">
    🔍 Dados para simulação
  </h2>

  <% if defined?(@resultado) && @resultado.present? && !@resultado[:sucesso] %>
    <div class="mb-6 rounded-xl border border-red-200 bg-red-50 p-4 text-red-700" role="alert">
      <p class="font-semibold"><%= @resultado[:mensagem] %></p>
      <% Array(@resultado[:detalhes]).each do |erro| %>
        <p><%= erro %></p>
      <% end %>
    </div>
  <% end %>

  <%# ⚠️ IMPORTANTE: usa o MESMO helper do GET e POST %>
  <%= form_with url: simular_frete_path, method: :post, local: true do %>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

      <div>
        <%= label_tag :origem, "Origem (CEP ou endereço)", class: "block text-sm font-semibold text-gray-800 mb-2" %>
        <%= text_field_tag :origem, params[:origem],
        aria: { label: "Origem (CEP ou endereço)" },
            placeholder: "Origem (CEP ou endereço)",
            required: true,
        class: "w-full rounded-xl border-gray-300 bg-white text-gray-900 caret-blue-600 placeholder:text-gray-500 px-4 py-3
                    focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
      </div>

      <div>
        <%= label_tag :destino, "Destino (CEP ou endereço)", class: "block text-sm font-semibold text-gray-800 mb-2" %>
        <%= text_field_tag :destino, params[:destino],
        aria: { label: "Destino (CEP ou endereço)" },
            placeholder: "Destino (CEP ou endereço)",
            required: true,
        class: "w-full rounded-xl border-gray-300 bg-white text-gray-900 caret-blue-600 placeholder:text-gray-500 px-4 py-3
                    focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
      </div>

      <div>
        <%= label_tag :peso, "Peso (kg)", class: "block text-sm font-semibold text-gray-800 mb-2" %>
        <%= text_field_tag :peso, params[:peso],
            aria: { label: "Peso em quilogramas" },
            placeholder: "Peso (kg)",
            pattern: "[0-9]+([.,][0-9]+)?",
            required: true,
            inputmode: "decimal",
            class: "w-full rounded-xl border-gray-300 bg-white text-gray-900 caret-blue-600 placeholder:text-gray-500 px-4 py-3
                    focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
      </div>

      <div>
        <%= label_tag :volume, "Volume (m³)", class: "block text-sm font-semibold text-gray-800 mb-2" %>
        <%= text_field_tag :volume, params[:volume],
            aria: { label: "Volume em metros cúbicos" },
            placeholder: "Volume (m³)",
            pattern: "[0-9]+([.,][0-9]+)?",
            required: true,
            inputmode: "decimal",
            class: "w-full rounded-xl border-gray-300 bg-white text-gray-900 caret-blue-600 placeholder:text-gray-500 px-4 py-3
                    focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
          </div>
    </div>

    <div class="mt-8">
      <%= submit_tag "Calcular Frete",
            class: "w-full bg-gradient-to-r from-blue-600 to-indigo-600
                    hover:opacity-90 text-white font-bold py-4
                    rounded-xl transition shadow-lg" %>
    </div>

  <% end %>
</section>

<!-- ==================================================
     CARD — CONTRATAÇÃO / PERFIS
================================================== -->
<section class="bg-gray-50 border border-dashed border-gray-300 rounded-2xl p-6">
  <h2 class="text-lg font-semibold text-gray-700 mb-2">
    🧾 Contratação e acesso
  </h2>

  <p class="text-sm text-gray-600 max-w-2xl">
    Após a simulação, o acesso muda conforme seu perfil.
  </p>

  <ul class="mt-3 text-sm text-gray-600 space-y-1">
    <li>• Clientes contratam com pagamento seguro</li>
    <li>• Transportadores recebem oportunidades no painel</li>
    <li>• Comissão da plataforma sempre transparente</li>
  </ul>

  <!-- ==================================================
       CTA DEFENSIVO (SEM ROTA QUEBRADA)
  ================================================== -->
  <div class="mt-6 flex flex-wrap gap-4">

    <% if defined?(cliente_signed_in?) && cliente_signed_in? %>
      <span class="inline-block bg-green-600 text-white
                   font-bold px-6 py-3 rounded-xl shadow">
        ✅ Você pode contratar este frete após a simulação
      </span>

    <% elsif defined?(transportador_signed_in?) && transportador_signed_in? &&
            respond_to?(:transportadores_dashboard_path) %>

      <%= link_to "Acessar painel de oportunidades",
                  transportadores_dashboard_path,
                  class: "inline-block bg-indigo-600 hover:bg-indigo-700
                          text-white font-bold px-6 py-3 rounded-xl
                          transition shadow" %>

    <% else %>

      <% if respond_to?(:new_cliente_session_path) %>
        <%= link_to "Entrar ou Criar Conta para Contratar",
                    new_cliente_session_path,
                    class: "inline-block bg-green-600 hover:bg-green-700
                            text-white font-semibold px-6 py-3 rounded-xl
                            transition shadow" %>
      <% end %>

      <% if respond_to?(:new_transportador_session_path) %>
        <%= link_to "Sou transportador",
                    new_transportador_session_path,
                    class: "inline-block border border-indigo-600 text-indigo-600
                            hover:bg-indigo-600 hover:text-white
                            font-semibold px-6 py-3 rounded-xl
                            transition shadow" %>
      <% end %>

    <% end %>
  </div>
</section>
