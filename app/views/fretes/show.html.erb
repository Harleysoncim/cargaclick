<h1 class="text-3xl font-extrabold mb-6 text-gray-800 dark:text-gray-100 flex items-center gap-2">
  📦 Detalhes do Frete
  <span class="text-xs font-semibold text-purple-400 tracking-wide">CC inside</span>
</h1>

<div class="bg-white dark:bg-gray-800 shadow-xl rounded-2xl p-6 space-y-6">

  <!-- Identificação -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
    <p>
      <span class="font-semibold text-gray-500 dark:text-gray-400">🆔 Código</span>
      <span class="ml-1 text-gray-900 dark:text-gray-100">
        #<%= @frete.id %>
      </span>
    </p>

    <p>
      <span class="font-semibold text-gray-500 dark:text-gray-400">⚙️ Situação</span>
      <span class="ml-2 align-middle">
        <%= status_badge(@frete) %>
      </span>
    </p>
  </div>

  <hr class="border-gray-200 dark:border-gray-700">

  <!-- Pessoas -->
  <div class="space-y-3 text-sm">
    <p>
      <span class="font-semibold text-gray-500 dark:text-gray-400">👤 Cliente</span>
      <span class="ml-1"><%= @frete.cliente&.nome || "Não informado" %></span>
    </p>

    <p>
      <span class="font-semibold text-gray-500 dark:text-gray-400">🚚 Quem leva</span>
      <span class="ml-1"><%= @frete.transportador&.nome || "A definir" %></span>
    </p>
  </div>

  <hr class="border-gray-200 dark:border-gray-700">

  <!-- Rota -->
  <div class="space-y-3 text-sm">
    <p>
      <span class="font-semibold text-gray-500 dark:text-gray-400">📍 Saída</span>
      <span class="ml-1"><%= @frete.origem %></span>
    </p>

    <p>
      <span class="font-semibold text-gray-500 dark:text-gray-400">🏁 Chegada</span>
      <span class="ml-1"><%= @frete.destino %></span>
    </p>
  </div>

  <hr class="border-gray-200 dark:border-gray-700">

  <!-- Valores -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
    <p>
      <span class="font-semibold text-gray-500 dark:text-gray-400">💸 Estimativa</span>
      <span class="ml-1">
        <%= number_to_currency(@frete.valor_estimado) if @frete.valor_estimado.present? %>
      </span>
    </p>

    <p>
      <span class="font-semibold text-gray-500 dark:text-gray-400">🏆 Final</span>
      <span class="ml-1 font-extrabold text-green-600">
        <%= number_to_currency(@frete.valor_final) if @frete.valor_final.present? %>
      </span>
    </p>
  </div>

  <!-- Easter egg discreto -->
  <p class="text-[11px] text-gray-400 italic text-center pt-3">
    ✨ CargaClick cuida do caminho — você só acompanha 🚛💨
  </p>

</div>

<!-- Navegação -->
<div class="mt-8 flex justify-start">
  <% if transportador_signed_in? && (@frete.transportador_id.nil? || @frete.transportador_id == current_transportador.id) %>
    <%= link_to "Seguro da carga", transportadores_frete_seguro_path(@frete),
                class: "mr-3 inline-flex items-center bg-purple-700 hover:bg-purple-800 text-white px-6 py-3 rounded-xl font-semibold transition shadow-md" %>
  <% end %>
  <%= link_to fretes_path,
              class: "inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-700
                      text-white px-6 py-3 rounded-xl font-semibold transition shadow-md" do %>
    ⬅️ Voltar para meus fretes
  <% end %>
</div>
