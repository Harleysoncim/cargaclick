# syntax=docker/dockerfile:1
FROM node:22-bookworm-slim AS node
FROM ruby:3.2.4-slim-bookworm AS build
WORKDIR /app
ENV RAILS_ENV=production BUNDLE_WITHOUT=development:test BUNDLE_DEPLOYMENT=1 BUNDLE_PATH=/usr/local/bundle
RUN apt-get update -qq && apt-get install -y --no-install-recommends build-essential git libpq-dev libvips pkg-config \
    && rm -rf /var/lib/apt/lists/*
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && npm install --global yarn@1.22.22
COPY Gemfile Gemfile.lock ./
RUN gem install bundler -v 2.7.2 --no-document && bundle install \
    && rm -rf /usr/local/bundle/cache /usr/local/bundle/ruby/*/cache \
    && for gem_dir in /usr/local/bundle/gems/* /usr/local/bundle/ruby/*/gems/*; do \
         rm -rf "$gem_dir/test" "$gem_dir/spec" "$gem_dir/features"; \
         rm -f "$gem_dir/README" "$gem_dir/README.md" "$gem_dir/README.rdoc"; \
       done \
    && find /usr/local/bundle -type f \( -name '*.log' -o -name gem_make.out \) -delete
COPY package.json yarn.lock ./
RUN yarn install --frozen-lockfile --production=false
COPY . .
RUN mkdir -p app/assets/builds tmp/pids log storage \
    && yarn build \
    && CARGACLICK_ASSET_BUILD=1 SECRET_KEY_BASE_DUMMY=1 bundle exec rails assets:precompile \
    && rm -f tmp/local_secret.txt log/*.log \
    && rm -rf node_modules tmp/cache

FROM ruby:3.2.4-slim-bookworm
WORKDIR /app
ENV RAILS_ENV=production RACK_ENV=production BUNDLE_WITHOUT=development:test BUNDLE_DEPLOYMENT=1 BUNDLE_PATH=/usr/local/bundle \
    RAILS_LOG_TO_STDOUT=1 RAILS_SERVE_STATIC_FILES=1 PORT=8080
RUN apt-get update -qq && apt-get install -y --no-install-recommends libpq5 libvips tzdata curl util-linux \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 rails
COPY --from=build /usr/local/bundle /usr/local/bundle
COPY --from=build --chown=rails:rails /app /app
RUN chmod +x bin/fly-start bin/fly-release \
    && mkdir -p /data/storage && chown -R rails:rails /data
EXPOSE 8080
CMD ["bash", "bin/fly-start"]
